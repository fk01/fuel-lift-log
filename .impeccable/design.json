  "narrative": {
    "northStar": "The Night Gym Console",
    "overview": "WeightGram is the control panel of a gym after dark: a deep navy room, chalk-white type, and instruments that light up only when they have something to say. Glow is a signal, not a finish.",
    "keyCharacteristics": [
      "Dark night-navy room, chalk-white text, one cyan→green signal gradient",
      "Tabular monospace numerals for every count, weight and time",
      "Heavy, rounded, thumb-sized controls (44 px targets, 48 px primary actions)",
      "Neon edge only on live / selected / next items",
      "Thai-first copy in IBM Plex Sans Thai"
    ],
    "rules": [
      {
        "name": "The Signal Pair Rule",
        "body": "Cyan and green travel together as the one primary-action gradient; alone, cyan means live and green means done.",
        "section": "colors"
      },
      {
        "name": "The Recovery Palette Rule",
        "body": "The muscle map palette is its own; never reuse it for UI chrome.",
        "section": "colors"
      },
      {
        "name": "The 12 px Floor Rule",
        "body": "No functional text below 12 px; inputs never below 16 px.",
        "section": "typography"
      },
      {
        "name": "The No-Shouting Rule",
        "body": "Sentence-case labels in the UI face; no forced uppercase mono labels.",
        "section": "typography"
      },
      {
        "name": "The Glow Means Live Rule",
        "body": "A card glows only when in progress, selected or next.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep one gradient primary action per screen.",
      "Do use the mono numeric face for every number a person compares (kg, sets, kcal, time).",
      "Do give every tappable thing 44 px of height.",
      "Do let state carry the glow: live = cyan, done = green, warn = amber, alarm = red.",
      "Do write Thai first and keep English the same length or shorter."
    ],
    "donts": [
      "Don't put colored glow on resting cards (Glow Means Live).",
      "Don't introduce new accent hues beyond cyan, green, amber and red.",
      "Don't use emoji as icons; use the line icon set.",
      "Don't set functional text under 12 px or inputs under 16 px.",
      "Don't use forced-uppercase letter-spaced labels."
    ]
  }
