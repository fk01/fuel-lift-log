{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuel-lift-log",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "fuel-lift-log", "database_id": "67913da1-ae9a-43e1-b600-be92ab1d4c07" }
  ],
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "fuel-lift-log-preview", "database_id": "bdd37cd8-8eab-4634-be0a-b7d152991e1a" }
    ],
    "vars": { "GOOGLE_CLIENT_ID": "" }
  },
  // ทุก 15 นาที (UTC) — โค้ดแปลงเป็นเวลาไทยแล้วเช็กมื้อที่ถึงเวลา
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  // Google Sign-In (public OAuth client id, not a secret)
  "vars": { "GOOGLE_CLIENT_ID": "124800862517-17lnbjsseeqp4af5strmm5t41eisvbme.apps.googleusercontent.com" },
  // เก็บ Variables ที่ตั้งใน Dashboard ไว้ ไม่ให้ถูกลบตอน deploy
  "keep_vars": true
}
